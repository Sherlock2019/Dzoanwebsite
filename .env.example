# Copy to .env.local (development) or set in your host's environment (production).
# Never commit real values.

# ---- Owner sign-in (required) ---------------------------------------------
OWNER_EMAIL=you@example.com
# Generate with:  npm run hash-password -- 'your-long-password'
OWNER_PASSWORD_HASH=
# At least 32 random characters, e.g.  openssl rand -base64 48
SESSION_SECRET=
# Session lifetime in hours (default 72)
SESSION_TTL_HOURS=72

# Public URL of the site (used for metadata and same-origin checks behind proxies)
SITE_URL=http://localhost:3100

# ---- Email (6-digit codes for "Full project details" downloads) ---------------
# Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste the 16 characters (no spaces).
# Any SMTP server works: set SMTP_HOST / SMTP_PORT too (465 = SSL, 587 = STARTTLS).
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM="Your Name" <you@gmail.com>
# Where download notifications go (default OWNER_EMAIL). NOTIFY_DOWNLOADS=0 turns them off.
# NOTIFY_EMAIL=

# ---- Data provider -------------------------------------------------------
# "local"    = JSON database + uploaded files under DATA_DIR. Durable only if DATA_DIR is on a
#              persistent disk/volume that survives redeploys (e.g. a VM or a Docker volume).
# "supabase" = Supabase Postgres + private Supabase Storage bucket (recommended for managed hosting).
DATA_PROVIDER=local
DATA_DIR=./.data

# ---- Supabase (only when DATA_PROVIDER=supabase) ---------------------------
SUPABASE_URL=
# Server-only key. Never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=portfolio-media

# ---- AI features (all optional; each one switches off cleanly when unset) ---
# Document database: Postgres + pgvector. ./start.sh fills these in and starts the
# docker-compose "rag-db" service automatically when Docker is available.
RAG_DB_PASSWORD=
RAG_DATABASE_URL=postgres://myweb:<RAG_DB_PASSWORD>@127.0.0.1:55434/myweb

# Local models through Ollama: embeddings for search, Qwen for document analysis.
#   ollama pull embeddinggemma && ollama pull qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=embeddinggemma
ANALYZE_MODEL=qwen2.5:7b

# Flowise orchestration for document analysis (optional; without it, analysis calls Qwen directly).
# ./start.sh runs it in Docker (service "flowise") on FLOWISE_PORT; set FLOWISE=0 to skip it.
# Create a chatflow that sends {question} to ChatOllama (qwen2.5:7b) — see README → AI features.
FLOWISE_PORT=3110
FLOWISE_URL=http://127.0.0.1:3110
FLOWISE_CHATFLOW_ID=
FLOWISE_API_KEY=

# Public recruiter chat (Claude). Server-only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5
# Hard cap on chat questions per day (cost control); per-visitor limit is 20 per 10 minutes.
CHAT_DAILY_LIMIT=1000
# Set to false to hide the chat even when a key is present.
CHAT_ENABLED=true
