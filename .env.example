# Copy to .env.local (development) or set in your host's environment (production).
# Never commit real values.

# ---- Owner sign-in (required) ---------------------------------------------
OWNER_EMAIL=you@example.com
# Generate with:  npm run hash-password -- 'your-long-password'
OWNER_PASSWORD_HASH=
# At least 32 random characters, e.g.  openssl rand -base64 48
SESSION_SECRET=
# Session lifetime in hours (default 72)
SESSION_TTL_HOURS=72

# Public URL of the site (used for metadata and same-origin checks behind proxies)
SITE_URL=http://localhost:3100

# ---- Data provider -------------------------------------------------------
# "local"    = JSON database + uploaded files under DATA_DIR. Durable only if DATA_DIR is on a
#              persistent disk/volume that survives redeploys (e.g. a VM or a Docker volume).
# "supabase" = Supabase Postgres + private Supabase Storage bucket (recommended for managed hosting).
DATA_PROVIDER=local
DATA_DIR=./.data

# ---- Supabase (only when DATA_PROVIDER=supabase) ---------------------------
SUPABASE_URL=
# Server-only key. Never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=portfolio-media
